# Get a real key at https://openrouter.ai/keys. This file is committed as a
# template; the real .env is not (see .gitignore) and must never be.
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY

# Only needed for cuttlefish/sandbox's E2bSandboxProvider (ADR-0002) and its
# requires_e2b_credential tests, which cost real money and never run in CI.
# Get a real key at https://e2b.dev/dashboard.
E2B_API_KEY=REPLACE_WITH_YOUR_E2B_KEY

# Only needed to use cuttlefish.secrets.SecretsStore (ADR-0006) -- generate a
# real one with `cuttlefish secrets generate-key` and never commit it. Unset
# (the default) means no project-scoped secrets store at all.
CUTTLEFISH_SECRETS_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY
